#
# wm independent hotkeys
#

# Показать клавиатурные сокращения
super + less
	~/scripts/kblist.sh

# Смена алфавита набранного текста
super + v
	~/scripts/puntoswitch.sh

# Терминал
super + Return
	alacritty

# Диспетчер файлов
super + e
	thunar

# Web-браузер
super + z
	firefox

# Системный монитор
ctrl + shift + Escape
	qps

# Завершение работы
alt + ctrl + Delete
	~/.config/rofi/powermenu/type-2/powermenu.sh

# Список приложений
super + d
	rofi -show combi -modes combi -combi-modes "window,drun" \
	-font "Hack Bold 12" -theme glue_pro_blue

# Перечитать конфигурацию sxhkd
super + Escape
	pkill -USR1 -x sxhkd | sxhkd -c /home/dm/.config/sxhkd/sxhkdrc_rus \
	| notify-send -t 2000 'sxhkd' 'Reload config'

# Понизить громкость
XF86AudioLowerVolume
	$HOME/.config/dunst/scripts/volume_show/volume.sh down
#	pulsemixer --change-volume -5

# Повысить громкость
XF86AudioRaiseVolume
	$HOME/.config/dunst/scripts/volume_show/volume.sh up
#	pulsemixer --change-volume +5

# Включить/выключить звук
XF86AudioMute
	$HOME/.config/dunst/scripts/volume_show/volume.sh mute
#	pulsemixer --toggle-mute

# MPD проигрывание/пауза
XF86AudioPlay
	mpc --host=e5450 toggle

# Яркость выше
super + Prior
	~/.config/polybar/scripts/brightness.sh up

# Яркость ниже
super + Next
	~/.config/polybar/scripts/brightness.sh down

# Заблокировать экран
super + l
	xset s activate

# Снимок экрана
Print
	flameshot gui

# История буфера обмена
super + c
    CM_LAUNCHER=rofi clipmenu \
        -location 1 \
        -m -3 \
        -no-show-icons \
        -theme-str '* \{ font: 10px; \}' \
        -theme-str 'listview \{ spacing: 0; \}' \
        -theme-str 'window \{ width: 30em; \}' \
		-theme glue_pro_blue \
		-window-title "Clipboard"

#
# bspwm hotkeys
#

# Выход/перезагрузка bspwm
super + alt + {q,r}
	bspc {quit,wm -r}

# Закрыть окно
super + {_,shift + }w
	bspc node -{c,k}

# Переключить текущее окно в режим монокля
super + m
	bspc desktop -l next

# send the newest marked node to the newest preselected node
super + y
	bspc node newest.marked.local -n newest.!automatic.local

# Поменять местами текущее окно и самое большое
super + g
	bspc node -s biggest.window

#
# state/flags
#

# Отображение окна (плитка, псевдо, плавающее, полный экран)
super + {t,shift + t,s,f}
	bspc node -t {tiled,pseudo_tiled,floating,fullscreen}

# set the node flags
super + ctrl + {m,x,y,z}
	bspc node -g {marked,locked,sticky,private}

#
# focus/swap
#

# Переключение между окнами на рабочем столе
super + {_,shift + }{Left,Down,Up,Right}
	bspc node -{f,s} {west,south,north,east}

# focus the node for the given path jump
super + {p,b,comma,period}
	bspc node -f @{parent,brother,first,second}

# Переключение окна на активном рабочем столе
super + {_,shift + }c
	bspc node -f {next,prev}.local.!hidden.window

# Переключение рабочего стола на активном мониторе
super + bracket{left,right}
	bspc desktop -f {prev,next}.local

# Активация предыдущего рабочего стола
super + {grave,Tab}
	bspc {node,desktop} -f last

# focus the older or newer node in the focus history
super + {o,i}
	bspc wm -h off; \
	bspc node {older,newer} -f; \
	bspc wm -h on

# Активировать рабочий стол или отправить окно на него
super + {_,shift + }{1-9,0}
	bspc {desktop -f,node -d} '^{1-9,10}'

#
# preselect
#

# Резервировать место в окне
super + ctrl + {Left,Down,Up,Right}
	bspc node -p {west,south,north,east}

# Резервировать пропорционально
super + ctrl + {1-9}
	bspc node -o 0.{1-9}

# Отменить резервирование
super + ctrl + space
	bspc node -p cancel

# Отменить всё резервирование на активном рабочем столе
super + ctrl + shift + space
	bspc query -N -d | xargs -I id -n 1 bspc node id -p cancel

#
# move/resize
#

# Увеличить окно
super + alt + {Left,Down,Up,Right}
	bspc node -z {left -20 0,bottom 0 20,top 0 -20,right 20 0}

# Уменьшить окно
super + alt + shift + {Left,Down,Up,Right}
	bspc node -z {right -20 0,top 0 20,bottom 0 -20,left 20 0}

# Передвинуть плавающее окно
super + ctrl + alt + {Left,Down,Up,Right}
	bspc node -v {-20 0,0 20,0 -20,20 0}
